# ==============================================================================
# PayGuard (.env.example) - Environment Variable Names
# ==============================================================================
# NOTE: Variable names ONLY. Never commit credentials, secrets, or fake values.
# Copy this file to .env for local development.

# --- Core Server Runtime ---
NODE_ENV=
PORT=
PUBLIC_BASE_URL=
DB_PATH=
# Express Trust Proxy:
# Default is false; proxy headers (e.g. X-Forwarded-For) are not trusted.
# Setting TRUST_PROXY=true trusts all proxy hops and should generally be avoided.
# Prefer an explicit hop count such as 1, or trusted proxy CIDRs (e.g. 'loopback', '10.0.0.0/8'), matching the actual deployment topology.
# Incorrect proxy configuration can allow spoofed client IP addresses and undermine IP-based rate limiting.
TRUST_PROXY=

# --- Safety & Environment Guard ---
# Sandbox only. Code refuses PRODUCTION unless ALLOW_PRODUCTION is explicitly set.
PAYPAL_ENV=
ALLOW_PRODUCTION=

# --- PayPal Sandbox Vendor Credentials ---
CONNECTOR_ACME_CLIENT_ID=
CONNECTOR_ACME_CLIENT_SECRET=

# --- Owner Authentication & Sessions ---
SESSION_SECRET=
OWNER_PASSPHRASE_HASH=

# --- Operational Limits & Policy Ceilings ---
HOLD_TTL_MINUTES=
MAX_HARD_CAP_MINOR=

# --- Zero-Spend Hosting / Demo Boot Configuration ---
RESEED_ON_BOOT=
DEMO_AGENT_API_KEY=
VAULT_TOKEN_ID=

# --- AI Services (Gemini Free Tier via AI Studio) ---
AI_PROVIDER=
# AI_MODEL: optional override (default: gemini-3.5-flash-lite)
AI_MODEL=
GEMINI_API_KEY=
# AI_SCAN_MODE: off | advisory | enforce (default: advisory)
AI_SCAN_MODE=advisory

# --- Telegram Bot Approvals (Optional) ---
# TELEGRAM_MODE: disabled (default) | webhook
TELEGRAM_MODE=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_ENCRYPTION_KEY=
TELEGRAM_PREVIOUS_ENCRYPTION_KEY=
