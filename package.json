{
  "name": "payguard",
  "version": "0.1.0",
  "description": "MCP policy firewall for AI agent payments on the PayPal sandbox",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test": "npm run test:unit",
    "build:server": "tsc",
    "build:web": "vite build",
    "build": "npm run build:server && npm run build:web",
    "dev:web": "vite",
    "agent:create": "tsx src/mcp/cli/createAgent.ts",
    "demo:seed": "tsx demo/seed.ts",
    "demo:reset": "tsx demo/reset.ts",
    "demo:honest": "tsx demo/honestAgent.ts",
    "demo:attack": "tsx demo/attackSimulator.ts",
    "vault:onboard": "tsx demo/onboardVault.ts"
  },
  "keywords": [
    "paypal",
    "mcp",
    "ai-agent",
    "firewall",
    "hackathon",
    "security"
  ],
  "author": "PayGuard Contributors",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.20.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^7.3.7",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@node-rs/argon2": "^2.2.2",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "express": "^5.3.0",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  }
}
